<?xml version="1.0" encoding="utf-8"?>
<!-- nothing is backed up: the device key must never leave the phone -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
